{
  "name": "@rebel-industry/specrun",
  "version": "0.1.0",
  "description": "Runs implementation specs task by task with Claude, unattended",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "specrun": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "plugin",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:typecheck": "tsc --noEmit --pretty false",
    "verify:test": "vitest run --reporter=dot",
    "verify:format": "prettier --check --log-level warn .",
    "check": "npm run -s verify:typecheck && npm run -s verify:test && npm run -s verify:format",
    "spike": "tsx spikes/sdk-spike.ts",
    "do": "npm run build && npm link"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "commander": "^15.1.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
